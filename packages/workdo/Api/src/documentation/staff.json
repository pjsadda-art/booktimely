    "staff-Create": {
        "method": "POST",
        "endpoints": "/api/:business_slug/staff-store",
        "header": {
            "Accept": "application/json",
            "Authorization": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUz..."
        },
        "request": {
            "name": "Name",
            "email": "email@gmail.com",
