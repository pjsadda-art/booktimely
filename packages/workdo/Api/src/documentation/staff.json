        },
        "status_code": {
            "success": "HTTP/1.1 200 OK",
            "error": "HTTP/1.1 404 Not Found"
        }
    },
    "staff-Delete": {
        "method": "DELETE",
        "endpoints": "/api/:business_slug/staff-delete/:staff_id",
        "header": {
