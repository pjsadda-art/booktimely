        },
        "status_code": {
            "success": "HTTP/1.1 200 OK",
            "error": "HTTP/1.1 404 Not Found"
        }
    },
    "staff-Update": {
        "method": "PUT",
        "endpoints": "/api/:business_slug/staff-update/:staff_id",
        "header": {
            "Accept": "application/json",
            "Authorization": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUz..."
